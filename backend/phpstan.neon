includes:
    - vendor/larastan/larastan/extension.neon
    # Erros que já existiam quando a análise passou a bloquear o CI. Não acrescente entradas:
    # corrija o erro novo e, ao limpar um antigo, regenere com
    #   vendor/bin/phpstan analyse --generate-baseline phpstan-baseline.neon
    - phpstan-baseline.neon

parameters:
    level: 6
    paths:
        - app/
    # O esquema vem de um dump SQL (database/schema), não de migrations em PHP
    squashedMigrationsPath:
        - database/schema
    reportUnmatchedIgnoredErrors: false
