# Copie para .env e preencha. Quase todos os nomes vêm da versão em CakePHP. Mudaram DEBUG (APP_DEBUG),
# APP_DEFAULT_LOCALE (APP_LOCALE) e SENTRY_DSN (SENTRY_LARAVEL_DSN); as linhas marcadas "Laravel" são novas.

# APP
APP_NAME="BeReady"
APP_ENV=local
# Laravel: chave de criptografia. Gere com `php artisan key:generate`
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8765
# URL do frontend (redirecionamentos do login social e links dos e-mails)
APP_BASE_URL="http://localhost:5173/"
APP_DEFAULT_TIMEZONE="America/Sao_Paulo"
APP_LOCALE=pt_BR

# SEGURANÇA
JWT_SECRET="coloque_um_segredo_longo_e_aleatorio_aqui"

# BANCO - PostgreSQL (local ou Supabase)
DATABASE_URL="postgres://USER:PASSWORD@HOST:5432/DB"
# Postgres descartável dos testes: o esquema é apagado e recriado a cada execução
TEST_DATABASE_URL="postgres://postgres:test@127.0.0.1:55432/beready_test"

# REDIS (opcional) - rate limit, uso diário da IA e códigos do login social.
# Sem REDIS_URL o cache fica em arquivo, o que só serve para um único processo (desenvolvimento).
# Com mais de uma instância da API, defina: redis://:senha@host:6379/0 (rediss:// para TLS)
REDIS_URL=

# CORS - origens permitidas (separadas por vírgula)
CORS_ALLOWED_ORIGINS="http://localhost:5173,http://localhost:5174,http://localhost:3000"

# E-MAIL - SMTP (sem EMAIL_HOST os e-mails vão para o log)
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="587"
EMAIL_USERNAME="seu-email@gmail.com"
EMAIL_PASSWORD="SUA_SENHA_DE_APP_AQUI"
EMAIL_FROM="seu-email@gmail.com"
EMAIL_FROM_NAME="BeReady"

# LOGS e SENTRY (Laravel: o Sentry lê SENTRY_LARAVEL_DSN)
LOG_CHANNEL=stack
LOG_LEVEL=debug
SENTRY_LARAVEL_DSN=

# CLOUDINARY (fotos de perfil)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_API_URL="https://api.cloudinary.com/v1_1"
CLOUDINARY_UPLOAD_FOLDER="beready/profile"

# LOGIN SOCIAL (as URLs dos provedores agora vêm do Socialite; só o callback é configurável)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:8765/social-auth/callback/google"
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
FACEBOOK_REDIRECT_URI="http://localhost:8765/social-auth/callback/facebook"
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
LINKEDIN_REDIRECT_URI="http://localhost:8765/social-auth/callback/linkedin"

# RECAPTCHA v3 (sem a chave, o login é recusado)
RECAPTCHA_SECRET_KEY=""
RECAPTCHA_VERIFY_URL="https://www.google.com/recaptcha/api/siteverify"

# STRIPE
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# AUTH - cookie httpOnly do refresh token (Path=/auth)
# SameSite: Lax (mesmo site) ou None (frontend em outro domínio; exige Secure=true)
REFRESH_COOKIE_SAMESITE="Lax"
REFRESH_COOKIE_SECURE=false

# IA - geração de traduções e frases (POST /prompts/{id}/traducoes/gerar e /frases/gerar)
# Sem ANTHROPIC_API_KEY esses dois endpoints respondem 503; o resto da API funciona normalmente.
ANTHROPIC_API_KEY=""
# Opcional: modelo (padrão claude-opus-5-5) e teto de gerações por usuário por dia (padrão 50)
ANTHROPIC_MODEL=""
IA_LIMITE_DIARIO=""
