# syntax=docker/dockerfile:1

FROM node:22-alpine AS base
WORKDIR /app
COPY frontend/package*.json ./
RUN npm ci

# ---------------------------------------------------------------------------------------------
# dev: código montado por volume (docker-compose) e servidor do Vite com HMR.
# ---------------------------------------------------------------------------------------------
FROM base AS dev
COPY frontend/ .
EXPOSE 5173
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]

# ---------------------------------------------------------------------------------------------
# build: as variáveis VITE_* são embutidas no bundle, por isso entram como build args.
# ---------------------------------------------------------------------------------------------
FROM base AS build
ARG VITE_API_URL
ARG VITE_APP_NAME=BeReady
ARG VITE_APP_ENV=production
ARG VITE_RECAPTCHA_SITE_KEY
ARG VITE_RECAPTCHA_JS_URL=https://www.google.com/recaptcha/api.js
ARG VITE_STRIPE_PUBLIC_KEY
ENV VITE_API_URL=$VITE_API_URL \
    VITE_APP_NAME=$VITE_APP_NAME \
    VITE_APP_ENV=$VITE_APP_ENV \
    VITE_RECAPTCHA_SITE_KEY=$VITE_RECAPTCHA_SITE_KEY \
    VITE_RECAPTCHA_JS_URL=$VITE_RECAPTCHA_JS_URL \
    VITE_STRIPE_PUBLIC_KEY=$VITE_STRIPE_PUBLIC_KEY
COPY frontend/ .
RUN npm run build

# ---------------------------------------------------------------------------------------------
# prod: só os arquivos estáticos, servidos pelo Nginx.
# ---------------------------------------------------------------------------------------------
FROM nginx:1.27-alpine AS prod
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
