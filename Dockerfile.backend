# syntax=docker/dockerfile:1

# Base comum: FrankenPHP (Caddy + PHP no mesmo processo) com as extensões que a API usa.
FROM dunglas/frankenphp:1-php8.4 AS base

RUN install-php-extensions pdo_pgsql intl mbstring zip redis opcache

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /app

# ---------------------------------------------------------------------------------------------
# dev: código montado por volume (docker-compose) e servidor embutido do Cake.
# ---------------------------------------------------------------------------------------------
FROM base AS dev

RUN apt-get update && apt-get install -y --no-install-recommends git unzip \
    && rm -rf /var/lib/apt/lists/*

COPY backend/composer.json backend/composer.lock ./
RUN composer install --no-scripts --no-autoloader --no-interaction

COPY backend/ .
RUN composer dump-autoload --optimize

EXPOSE 8765
CMD ["php", "bin/cake.php", "server", "--host", "0.0.0.0", "--port", "8765"]

# ---------------------------------------------------------------------------------------------
# prod: sem dependências de desenvolvimento, opcache ligado, servido pelo FrankenPHP.
# ---------------------------------------------------------------------------------------------
FROM base AS prod

RUN mv "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini"
COPY docker/php-prod.ini "$PHP_INI_DIR/conf.d/zz-beready.ini"

COPY backend/composer.json backend/composer.lock ./
RUN composer install --no-dev --no-scripts --no-autoloader --no-interaction --prefer-dist

COPY backend/ .
RUN composer dump-autoload --optimize --classmap-authoritative --no-dev \
    && mkdir -p logs tmp/cache/models tmp/cache/persistent tmp/cache/views tmp/sessions \
    && chown -R www-data:www-data logs tmp

COPY docker/Caddyfile /etc/frankenphp/Caddyfile

USER www-data
EXPOSE 8765
CMD ["frankenphp", "run", "--config", "/etc/frankenphp/Caddyfile", "--adapter", "caddyfile"]
